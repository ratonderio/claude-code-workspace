# Secrets for Family HQ. Copy to .env (which git ignores). Never commit real values.
# Lines are KEY=value with no quotes needed.

# Phase 2: Discord bot token (Discord developer portal -> your application -> Bot -> Reset Token)
# FAMILY_HQ_DISCORD_TOKEN=

# Phase 7: AI provider key (optional; AI is never required)
# FAMILY_HQ_AI_API_KEY=

# Optional: point the CLI at a config file in another location
# FAMILY_HQ_CONFIG=C:\path\to\config.toml
